# Required. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5-5
ANTHROPIC_MODEL=
# Optional. Requests per IP per 10 minutes for the tool (best effort). Defaults to 30.
RATE_LIMIT_PER_10_MIN=

# Where newsletter sign-ups and employer pilot requests go (JSON POST).
# A Google Sheets Apps Script web app, a Zapier/Make webhook or a Formspree endpoint all work.
# Without it, the forms say sign-ups aren't switched on yet.
LEADS_WEBHOOK_URL=

# Your public address, used for share previews and the sitemap, e.g. https://adjacent.work
NEXT_PUBLIC_SITE_URL=
# Optional. Shown in the footer for employers.
NEXT_PUBLIC_CONTACT_EMAIL=
