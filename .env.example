# Required. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5-5
ANTHROPIC_MODEL=
# Optional. Requests per IP per 10 minutes for the tool (best effort). Defaults to 30.
RATE_LIMIT_PER_10_MIN=

# Where newsletter sign-ups and employer pilot requests go (JSON POST).
# A Google Sheets Apps Script web app, a Zapier/Make webhook or a Formspree endpoint all work.
# Without it, the forms say sign-ups aren't switched on yet.
LEADS_WEBHOOK_URL=

# Your public address, used for share previews and the sitemap, e.g. https://adjacent.work
NEXT_PUBLIC_SITE_URL=
# Contact for employers and for data requests (shown in the footer and privacy policy).
NEXT_PUBLIC_CONTACT_EMAIL=

# Postgres for the pool, roles and outcomes. Neon, Supabase or Vercel Postgres.
# Without it, local development uses an embedded database in .data/ (not for production).
DATABASE_URL=
# Password for the operator area at /admin. At least 12 characters; shorter ones are refused.
ADMIN_PASSWORD=
# Optional. Signs operator sessions; changing it signs everyone out. A long random string.
ADMIN_SESSION_SECRET=
# Secret for the daily retention job (Vercel sends it automatically once set). A long random string.
CRON_SECRET=

# Shown in the privacy policy as the data controller: your name or company, address and tax ID.
NEXT_PUBLIC_CONTROLLER_NAME=
# Optional. A proven move is shown publicly only once it has this many hires. Defaults to 3.
MIN_PUBLIC_HIRES=
